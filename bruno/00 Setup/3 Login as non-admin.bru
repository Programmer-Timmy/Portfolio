meta {
  name: 3 Login as non-admin
  type: http
  seq: 3
}

post {
  url: {{apiUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{userUsername}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  const raw = res.getHeader('set-cookie') || [];
  const list = Array.isArray(raw) ? raw : [raw];
  const sid = list
    .map((c) => String(c).split(';')[0].trim())
    .find((c) => c.toLowerCase().startsWith('phpsessid='));
  if (sid) bru.setVar('sessionUser', sid);
}

assert {
  res.status: eq 200
  res.body.data.authenticated: eq true
  res.body.data.admin: eq false
}
