meta {
  name: 10 Restore
  type: http
  seq: 10
}

post {
  url: {{apiUrl}}/admin/videos/{{videoId}}/restore
  body: none
  auth: none
}

headers {
  Cookie: {{sessionAdmin}}
  X-CSRF-Token: {{csrfAdmin}}
}

assert {
  res.status: eq 204
}

docs {
  Puts the test video back on the site - leaves the videos table as it was.
}
