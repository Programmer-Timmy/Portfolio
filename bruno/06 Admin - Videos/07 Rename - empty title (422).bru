meta {
  name: 07 Rename - empty title (422)
  type: http
  seq: 7
}

patch {
  url: {{apiUrl}}/admin/videos/{{videoId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: {{sessionAdmin}}
  X-CSRF-Token: {{csrfAdmin}}
}

body:json {
  {
    "title": "   "
  }
}

assert {
  res.status: eq 422
  res.body.error.code: eq validation_error
  res.body.error.fields.title: eq Enter a title.
}
