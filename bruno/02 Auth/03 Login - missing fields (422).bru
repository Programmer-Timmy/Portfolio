meta {
  name: 03 Login - missing fields (422)
  type: http
  seq: 3
}

post {
  url: {{apiUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "",
    "password": ""
  }
}

assert {
  res.status: eq 422
  res.body.error.code: eq validation_error
  res.body.error.fields.username: eq Enter your username.
  res.body.error.fields.password: eq Enter your password.
}
