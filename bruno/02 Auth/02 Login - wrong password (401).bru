meta {
  name: 02 Login - wrong password (401)
  type: http
  seq: 2
}

post {
  url: {{apiUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{adminUsername}}",
    "password": "definitely-wrong"
  }
}

assert {
  res.status: eq 401
  res.body.error.code: eq unauthorized
  res.body.error.message: eq Incorrect username or password.
}
