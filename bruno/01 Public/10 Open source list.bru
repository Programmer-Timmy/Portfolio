meta {
  name: 10 Open source list
  type: http
  seq: 10
}

get {
  url: {{apiUrl}}/opensource
  body: none
  auth: none
}

script:post-response {
  const first = res.body && res.body.data && res.body.data[0];
  if (first) bru.setVar('publicOpenSourceId', first.id);
}

assert {
  res.status: eq 200
  res.body.data: isArray
  res.body.meta.count: isNumber
  res.body.meta.pullRequestTotal: isNumber
}
