meta {
  name: 08 Create - malformed payload (422)
  type: http
  seq: 8
}

post {
  url: {{apiUrl}}/admin/projects
  body: multipartForm
  auth: none
}

headers {
  Cookie: {{sessionAdmin}}
  X-CSRF-Token: {{csrfAdmin}}
}

body:multipart-form {
  payload: not json at all
}

assert {
  res.status: eq 422
  res.body.error.code: eq validation_error
  res.body.error.fields.payload: eq The form data was malformed.
}
