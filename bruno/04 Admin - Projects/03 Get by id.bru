meta {
  name: 03 Get by id
  type: http
  seq: 3
}

get {
  url: {{apiUrl}}/admin/projects/{{adminProjectId}}
  body: none
  auth: none
}

headers {
  Cookie: {{sessionAdmin}}
}

assert {
  res.status: eq 200
  res.body.data.id: isNumber
  res.body.data.imagePaths: isArray
  res.body.data.languages: isArray
}
